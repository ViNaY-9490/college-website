# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecell_vitb?appName=Cluster0

# Authentication & Security
JWT_SECRET=your_jwt_secret_min_32_chars_random_key_here

# App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default Admin Credentials for Initial Bootstrap Seed
ADMIN_INITIAL_EMAIL=admin@ecellvitb.in
ADMIN_INITIAL_PASSWORD=Admin@ECell2026!

# Optional Cloudinary (for uploaded media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Email Service (Resend or SMTP)
RESEND_API_KEY=
EMAIL_FROM=notifications@ecellvitb.in

# Optional Google Analytics
NEXT_PUBLIC_GA_ID=

# Ox Alpha AI Model Configuration (Tokenra / OpenAI-compatible)
OX_ALPHA_API_KEY=your_ox_alpha_tokenra_api_key_here
OX_ALPHA_BASE_URL=https://tokenra.io/v1
OX_ALPHA_MODEL=stealth/ox-alpha
